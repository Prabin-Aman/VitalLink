# Copy to backend/.env for local runs and fill in a password. Never commit .env.
ENV=local
# Comma-separated; add http://localhost:8081 to try the mobile app's web build against this API.
CORS_ORIGIN=http://localhost:5173

# Postgres in docker-compose.yml (local only)
POSTGRES_USER=vitallink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vitallink
POSTGRES_PORT=5432
# Either form works: postgresql://user:password@host:port/db (as Supabase shows it), or a JDBC URL plus
# DATABASE_USER and DATABASE_PASSWORD. Use 127.0.0.1, not localhost, on Windows (localhost costs 2 s per connection).
DATABASE_URL=postgresql://vitallink:change-me@127.0.0.1:5432/vitallink
# DATABASE_POOL_SIZE=10

# Auth. Local/test only: signs dev tokens (DevToken tool). Production uses SUPABASE_URL.
DEV_JWT_SECRET=change-me-to-a-long-random-string-of-32-characters-or-more
# SUPABASE_URL=https://<project>.supabase.co
# Production only: deletes sign-in identities on account delete and signs Storage URLs. Server-side secret.
# SUPABASE_SERVICE_ROLE_KEY=

# Files. Without Supabase, local runs keep uploads in STORAGE_DIR behind signed URLs served by the API.
# STORAGE_BUCKET=records
# STORAGE_DIR=.storage
# PUBLIC_API_URL=http://localhost:8000

# The nightly job (POST /internal/jobs/nightly, header X-Job-Secret). Unset = the endpoint answers 503.
JOB_SECRET=change-me-too

# PORT=8000
