# Copy to backend/.env for local runs and fill in a password. Never commit .env.
ENV=local
CORS_ORIGIN=http://localhost:5173

# Postgres in docker-compose.yml (local only)
POSTGRES_USER=vitallink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vitallink
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vitallink:change-me@127.0.0.1:5432/vitallink

# Auth. Local/test only: signs dev tokens (python -m app.devtoken). Production uses SUPABASE_URL.
DEV_JWT_SECRET=change-me-to-a-long-random-string
# SUPABASE_URL=https://<project>.supabase.co
