{
  "name": "vitallink-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "tokens": "node packages/tokens/build.mjs",
    "icons": "python3 scripts/write-icons.py",
    "web": "npm run dev -w @vitallink/web",
    "web:build": "npm run build -w @vitallink/web",
    "mobile": "npm run start -w @vitallink/mobile",
    "typecheck": "npm exec -w @vitallink/web -- tsc --noEmit && npm exec -w @vitallink/mobile -- tsc --noEmit",
    "mobile:web": "npm run web -w @vitallink/mobile",
    "api:types": "openapi-typescript http://localhost:8000/openapi.json -o packages/api/src/openapi.gen.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vitest": "^3.2.7"
  }
}
