# Copy to apps/web/.env.local (not committed). Without VITE_API_URL the portal shows demo data and saves nothing.
VITE_API_URL=http://localhost:8000
# Optional, for local tools only: a dev token (backend DevToken tool) instead of signing in.
# VITE_DEV_TOKEN=
# Production sign-in (Vercel): Supabase Auth. Leave unset locally to use the API's own email/password accounts.
# Only the publishable key goes here; the secret key belongs on Render, never in the web app.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_GOOGLE=1
